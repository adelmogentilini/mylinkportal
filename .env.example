# Copy this file to .env and fill in the values (never commit .env).

# Login for the web UI (public/login.html)
PORTAL_USER=admin
PORTAL_PASSWORD=change-me

# Shared secret between server.js and telegram-bot.js.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PORTAL_BOT_TOKEN=

# Token from @BotFather on Telegram, used only by telegram-bot.js
TELEGRAM_BOT_TOKEN=

# Optional: comma-separated Telegram chat ids allowed to add links.
# Leave empty to allow anyone who messages the bot.
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional: base URL of the running portal server, used only by telegram-bot.js
PORTAL_API_URL=http://localhost:3000
